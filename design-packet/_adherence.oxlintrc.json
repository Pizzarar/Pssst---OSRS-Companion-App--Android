{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/data/**",
              "components/docs/**",
              "components/icons/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ds-loader.js",
              "ui_kits/android-app/**",
              "ui_kits/setup-guide/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Alegreya|JetBrains Mono|Silkscreen))/i]",
        "message": "Font not provided by the design system. Available: Alegreya, JetBrains Mono, Silkscreen."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<AppIcon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppIcon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:menu|shield|chest|coins|star|hourglass)$/]",
        "message": "<AppIcon> name must be one of 'menu' | 'shield' | 'chest' | 'coins' | 'star' | 'hourglass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<BottomNavItem> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavItem'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:shield|chest|coins|star|hourglass|menu)$/]",
        "message": "<BottomNavItem> icon must be one of 'shield' | 'chest' | 'coins' | 'star' | 'hourglass' | 'menu'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, tone, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|text)$/]",
        "message": "<Button> variant must be one of 'filled' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|danger|sync)$/]",
        "message": "<Button> tone must be one of 'accent' | 'danger' | 'sync'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: kind, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:tip|warning|note)$/]",
        "message": "<Callout> kind must be one of 'tip' | 'warning' | 'note'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|label|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, onChange, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|copyable|style|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: children, label, copyable, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|sub|key|ref|className|style|children)$/]",
        "message": "<FlowNode> doesn't accept that prop. Declared props: label, icon, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<DocIcon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|style|key|ref|className|style|children)$/]",
        "message": "<DocTable> doesn't accept that prop. Declared props: columns, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DrawerItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<DrawerItem> doesn't accept that prop. Declared props: selected, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FanFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|key|ref|className|style|children)$/]",
        "message": "<FanFooter> doesn't accept that prop. Declared props: style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|shape|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: selected, shape, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|chip)$/]",
        "message": "<FilterChip> shape must be one of 'square' | 'chip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|quantity|iconSrc|empty|slotNumber|size|style|key|ref|className|style|children)$/]",
        "message": "<ItemSlot> doesn't accept that prop. Declared props: name, quantity, iconSrc, empty, slotNumber, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:padding|radius|as|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: padding, radius, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|thin|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, tone, thin, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|accent|danger)$/]",
        "message": "<ProgressBar> tone must be one of 'success' | 'accent' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<SegmentedTab> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SettingChip> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:hasItem|padding|radius|children|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: hasItem, padding, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: tone, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ready|done|neutral|gold|active|danger)$/]",
        "message": "<StatusChip> tone must be one of 'ready' | 'done' | 'neutral' | 'gold' | 'active' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|children|detail|style|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: n, children, detail, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepNumber'] > JSXAttribute > JSXIdentifier[name!=/^(?:n|size|style|key|ref|className|style|children)$/]",
        "message": "<StepNumber> doesn't accept that prop. Declared props: n, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|onChange|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, defaultChecked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|supportingText|error|mono|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, placeholder, supportingText, error, mono, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|syncedAgo|onMenu|onSync|actionLabel|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, syncedAgo, onMenu, onSync, actionLabel, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
