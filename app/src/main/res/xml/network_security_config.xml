<?xml version="1.0" encoding="utf-8"?>
<!--
  The app makes no outbound HTTP requests in production (it only receives pushes via ServerSocket on the local network).
  Disallow outbound cleartext by default to satisfy Play Store security checks, permitting loopback only for local tests.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
